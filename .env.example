# ─── Caption AI — Environment Variables ───

# Optional provider keys. Configure at least one transcription provider.
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=
SARVAM_API_KEY=

# Speech-to-text provider.
# auto = Sarvam for code-mixed Indian modes when available, then OpenAI Whisper, then Groq Whisper.
# groq_whisper/whisper = Groq Whisper large-v3.
# openai_whisper = OpenAI whisper-1 with word timestamp granularities.
# sarvam = Sarvam Saaras v3 translit mode. Recommended for production Telgish/Auto Mixed.
STT_PROVIDER=auto

# Optional: Path to FFmpeg executable (for video rendering/export)
# Download from https://ffmpeg.org/download.html
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# Optional: Server configuration
PORT=8000
HOST=127.0.0.1
MAX_UPLOAD_SIZE_MB=500
RENDER_PAGE_URL=http://localhost:3000/render
