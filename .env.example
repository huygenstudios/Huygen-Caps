# Huygen Caps environment

# Backend
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=
MAX_UPLOAD_SIZE_MB=500
EXPORT_CONCURRENCY=1
MAX_CONCURRENT_EXPORTS=1
MAX_EXPORT_DURATION_SECONDS=300
MAX_SUBTITLE_IMPORT_BYTES=2097152
MAX_AUDIO_UPLOAD_BYTES=26214400
MAX_AUDIO_DURATION_SECONDS=120
AUDIO_DEFAULT_WIDTH=1080
AUDIO_DEFAULT_HEIGHT=1920
AUDIO_DEFAULT_FPS=30
AUDIO_DEFAULT_BACKGROUND=#111111

# Runtime storage. Render disk is ephemeral; use external object storage later for persistence.
# For KVM 1, use Cloudflare R2
STORAGE_BACKEND=local
FREE_UPLOAD_TTL_HOURS=24
FREE_EXPORT_TTL_HOURS=24
TEMP_DIR=/tmp/huygen-caps
UPLOAD_DIR=/tmp/huygen-caps/uploads
EXPORT_DIR=/tmp/huygen-caps/exports

# Supabase Auth / Postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=
DB_PATH=/tmp/huygen-caps/database.sqlite
RUNTIME_CLEANUP_HOURS=24

# Frontend API base.
# Local Next dev can omit this and will call http://127.0.0.1:8000.
# The single Docker Render deployment should leave this blank so the static
# frontend calls the same-origin FastAPI service at /api.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_RENDER_ENV=

# Headless MP4 export render page.
# Local dev should point at the Next dev server. Docker/Render can omit this
# and the backend will use http://127.0.0.1:$PORT/render.html.
RENDER_PAGE_URL=http://localhost:3000/render
EXPORT_BROWSER_TIMEOUT_MS=180000
EXPORT_FRAME_TIMEOUT_MS=30000
EXPORT_MAX_RETRIES=2
EXPORT_DEFAULT_FPS=60
EXPORT_MAX_FPS=60
EXPORT_ENABLE_LAYER_PREFLIGHT=true
EXPORT_LAYERED_RENDER_PAGE_RECYCLE_FRAMES=240
EXPORT_RENDER_SAFE_MODE=true
EXPORT_MAX_LONG_EDGE=1920
EXPORT_FFMPEG_THREADS=1

# Speech-to-text provider.
# auto = Sarvam for Indian code-mixed modes when available, then OpenAI, then Groq.
# groq_whisper/whisper = Groq Whisper large-v3.
# openai_whisper = OpenAI whisper-1.
# sarvam = Sarvam Saaras v3 translit mode.
# deepgram = NOT YET IMPLEMENTED. Do not set as STT_PROVIDER until integration is done.
STT_PROVIDER=auto
GROQ_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
# Deepgram is planned as a fallback STT provider, but is not production-ready yet.
# The pipeline will NOT auto-select Deepgram even if this key is set.
# To enable Deepgram auto-selection: also set STT_DEEPGRAM_ENABLED=true
DEEPGRAM_API_KEY=
STT_DEEPGRAM_ENABLED=false

# Caption timing and alignment.
# Default production is lightweight. Install requirements-optional-ai.txt only
# on a worker/GPU machine for heavy local alignment.
ALIGNMENT_PROVIDER=auto
ENABLE_WHISPERX=false
ENABLE_SILERO_VAD=false
PAUSE_SPLIT_THRESHOLD=0.45
DEFAULT_GLOBAL_CAPTION_OFFSET=0

# Caption sync engine
ENABLE_AUTO_GLOBAL_SYNC=false
AUTO_SYNC_MAX_SHIFT_SECONDS=2.0
AUTO_SYNC_MIN_SCORE=0.58
AUTO_SYNC_MIN_IMPROVEMENT=0.04
AUTO_SYNC_FRAME_STEP_SECONDS=0.02
AUTO_SYNC_ALLOW_SKEW=true
AUTO_SYNC_MAX_SKEW_DELTA=0.035
AUTO_SYNC_MAX_ESTIMATED_WORD_RATIO=0.70

# stable-ts high-quality refinement
ENABLE_STABLE_TS=false
STABLE_TS_MODEL=base
STABLE_TS_DEVICE=auto
STABLE_TS_MIN_MATCH_COVERAGE=0.50
STABLE_TS_MIN_WORD_RATIO=0.45
STABLE_TS_MAX_WORD_RATIO=2.25

# Optional local FFmpeg binary. Leave as "ffmpeg" or blank when FFmpeg is on PATH.
FFMPEG_PATH=ffmpeg
