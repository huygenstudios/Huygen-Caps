# Huygen Caps environment

# Backend
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=500

# Runtime storage. Render disk is ephemeral; use external object storage later for persistence.
TEMP_DIR=/tmp/huygen-caps
UPLOAD_DIR=/tmp/huygen-caps/uploads
EXPORT_DIR=/tmp/huygen-caps/exports
DB_PATH=/tmp/huygen-caps/database.sqlite
RUNTIME_CLEANUP_HOURS=24

# Frontend API base.
# Local Next dev can omit this and will call http://127.0.0.1:8000.
# The single Docker Render deployment should leave this blank so the static
# frontend calls the same-origin FastAPI service at /api.
NEXT_PUBLIC_API_URL=

# Headless MP4 export render page.
# Local dev should point at the Next dev server. Docker/Render can omit this
# and the backend will use http://127.0.0.1:$PORT/render.html.
RENDER_PAGE_URL=http://localhost:3000/render

# Speech-to-text provider.
# auto = Sarvam for Indian code-mixed modes when available, then OpenAI, then Groq.
# groq_whisper/whisper = Groq Whisper large-v3.
# openai_whisper = OpenAI whisper-1.
# sarvam = Sarvam Saaras v3 translit mode.
STT_PROVIDER=auto
GROQ_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# Optional local FFmpeg binary. Leave as "ffmpeg" or blank when FFmpeg is on PATH.
FFMPEG_PATH=ffmpeg
