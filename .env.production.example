# ========================================================
# Capinsta Stage 1 Production Environment Variables
# Target: Hostinger VPS KVM 1 / Coolify
# ========================================================

# --------------------------------------------------------
# 1. App Configuration
# --------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
FRONTEND_URL=https://capinsta.huygenstudios.com
CORS_ORIGINS=https://capinsta.huygenstudios.com
PUBLIC_APP_URL=https://capinsta.huygenstudios.com

# --------------------------------------------------------
# 2. Hostinger KVM 1 / Coolify Paths
# --------------------------------------------------------
# These must map to a shared persistent volume in Coolify.
# The API container and Worker container MUST share this.
TEMP_DIR=/data/tmp
UPLOAD_DIR=/data/uploads
EXPORT_DIR=/data/exports
DB_PATH=/data/database.sqlite
RUNTIME_CLEANUP_HOURS=24

# --------------------------------------------------------
# 3. Storage (Local / R2)
# --------------------------------------------------------
# local: serves directly from /data (fine for single node).
# r2: uploads to Cloudflare R2 and serves presigned URLs.
STORAGE_BACKEND=local

# Cloudflare R2 (Required if STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=capinsta-production
R2_ENDPOINT_URL=https://your_r2_account_id.r2.cloudflarestorage.com/capinsta-production
R2_PUBLIC_DOMAIN=

# --------------------------------------------------------
# 4. Supabase Auth
# --------------------------------------------------------
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
DATABASE_URL=

# --------------------------------------------------------
# 5. Razorpay Billing
# --------------------------------------------------------
# Set to false to disable billing enforcement for initial launch
RAZORPAY_BILLING_ENABLED=true
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR
RAZORPAY_PLAN_FREE=free
RAZORPAY_PLAN_CREATOR_ID=plan_creator_id
RAZORPAY_PLAN_PRO_ID=plan_pro_id
BILLING_SUCCESS_URL=https://capinsta.huygenstudios.com/billing/success
BILLING_CANCEL_URL=https://capinsta.huygenstudios.com/billing/cancel
# --------------------------------------------------------
# 6. Speech-To-Text (Sarvam & Deepgram)
# --------------------------------------------------------
STT_PROVIDER=auto
SARVAM_API_KEY=your_sarvam_api_key
# Deepgram is intentionally disabled for Stage 1
DEEPGRAM_API_KEY=
STT_DEEPGRAM_ENABLED=false

# --------------------------------------------------------
# 7. Export Worker (Critical safety caps for KVM 1)
# --------------------------------------------------------
# DO NOT INCREASE THESE VALUES ON A 1GB RAM SERVER
WORKER_CONCURRENCY=1
EXPORT_CONCURRENCY=1
MAX_CONCURRENT_EXPORTS=1
EXPORT_FFMPEG_THREADS=1
EXPORT_MAX_FPS=30
EXPORT_MAX_LONG_EDGE=1080

# --------------------------------------------------------
# 8. Upload Limits & TTLs
# --------------------------------------------------------
MAX_UPLOAD_SIZE_MB=500
MAX_AUDIO_UPLOAD_BYTES=26214400
MAX_AUDIO_DURATION_SECONDS=120
FREE_UPLOAD_TTL_HOURS=24
FREE_EXPORT_TTL_HOURS=24
